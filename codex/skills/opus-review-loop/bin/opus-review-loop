#!/usr/bin/env python3
"""Compatibility entry point for the renamed claude-review-loop harness."""
import os
import sys


HERE = os.path.dirname(os.path.abspath(__file__))
CANONICAL = os.path.realpath(os.path.join(
    HERE, "..", "..", "claude-review-loop", "bin", "claude-review-loop"
))

if __name__ == "__main__":
    os.execv(sys.executable, [sys.executable, CANONICAL, "--model", "opus", *sys.argv[1:]])
