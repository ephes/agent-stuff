#!/usr/bin/env python3
import os
import sys

import shutil
import subprocess


def ensure_python():
    """Bootstrap before importing modules that require Python 3.10+."""
    if sys.version_info >= (3, 10):
        return
    for minor in range(19, 9, -1):
        candidate = shutil.which("python3.%d" % minor)
        if not candidate:
            continue
        try:
            probe = subprocess.run(
                [candidate, "-c", "import sys; sys.exit(sys.version_info < (3, 10))"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5,
            )
            if probe.returncode != 0:
                continue
            os.execv(candidate, [candidate, os.path.abspath(__file__)] + sys.argv[1:])
        except (OSError, subprocess.TimeoutExpired):
            continue
    raise SystemExit("%s requires Python 3.10+; install python3.10 or newer on PATH." %
                     os.path.basename(__file__))


ensure_python()

# Make the skill root importable when run as a standalone script.
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from pi_review_loop.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
